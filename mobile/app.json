{
  "expo": {
    "name": "Chris Fitness",
    "slug": "chrisfitness",
    "scheme": "chrisfitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chrisfitness.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.chrisfitness.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A5C8A"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F2F2F7"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Chris Fitness necesita acceder a tus fotos para que subas fotos de progreso que solo verá tu entrenador.",
          "cameraPermission": "Chris Fitness necesita la cámara para que hagas fotos de progreso que solo verá tu entrenador.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
