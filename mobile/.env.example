# Copia este archivo como .env (no se sube a git).
# Mismos valores que la web: Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La clave "anon" es pública por diseño (la seguridad la ponen las reglas RLS).
# ⚠️ NUNCA pongas aquí la service_role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Dirección de la web publicada en Vercel (para "He olvidado mi contraseña" y la política de privacidad)
EXPO_PUBLIC_WEB_URL=https://app.tudominio.com
# Email que recibe las solicitudes de eliminación de cuenta (obligatorio para App Store)
EXPO_PUBLIC_CONTACT_EMAIL=
